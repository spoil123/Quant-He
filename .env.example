# ============================================================
# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中，不会进版本库。
# ============================================================

# ---------------- 数据库（必填） ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 在下面这行填你的 MySQL root 密码。
# 注意：注释必须独占一行，不要写成 DB_PASSWORD=xxx  # 注释 的形式 ——
# python-dotenv 会把整行后面的内容都当成密码值，导致莫名其妙的连接错误。
DB_PASSWORD=
DB_NAME=quant

# ---------------- 日志 ----------------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------------- 通知（第5层，可选） ----------------
# 邮件告警
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=

# 企业微信机器人
NOTIFY_WECHAT_ENABLED=false
WECHAT_WEBHOOK=

# ---------------- AKShare 抓取参数 ----------------
# 单只股票请求间隔（秒），防止被限流封 IP
AK_REQUEST_INTERVAL=0.25
# 单接口最大重试次数
AK_MAX_RETRY=3
# 全量抓取时的并发线程数（保守为 4，太高易被封）
AK_MAX_WORKERS=4
# 每批抓取后的长休息间隔（秒）与批次大小
AK_BATCH_SIZE=200
AK_BATCH_SLEEP=5
